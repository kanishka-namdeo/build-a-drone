{
  "name": "build-a-drone",
  "version": "1.1.0",
  "description": "Drone Lab \u2014 a virtual drone builder: hand-inked drones you design, build, and then fly. An interactive FPV drone engineering workshop in your browser.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "drone",
    "fpv",
    "quadcopter",
    "simulator",
    "education",
    "betaflight",
    "ardupilot",
    "isometric"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanishka-namdeo/build-a-drone.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}